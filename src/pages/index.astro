---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import HowIWork from '../components/HowIWork.astro';
import Timeline from '../components/Timeline.astro';
import WhoIWorkBestWith from '../components/WhoIWorkBestWith.astro';
import ContactBand from '../components/ContactBand.astro';
import DiagonalBoundary from '../components/DiagonalBoundary.astro';
import OpportunityTeaser from '../components/OpportunityTeaser.astro';
import { site, contactHref } from '../data/site';

const pageTitle = 'Dawid Golebiewski — AI, Data, and Product for Enterprises ';
const pageDescription = 'Dawid Golebiewski helps enterprise teams fix the operating problems that keep AI access from turning into business capacity, trusted delivery, and measurable value.';
const pageUrl = `${site.url}/`;
const ogImageUrl = `${site.url}${site.ogImage}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content="Fix the operating problems that keep AI access from turning into trusted delivery, business capacity, and measurable value." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`Portrait of ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header wrap">
      <a class="name" href="#main">{pageTitle}</a>
      <nav aria-label="Main navigation"><a href="#approach">Approach</a><a href="#experience">Track record</a></nav>
    </header>
    <main id="main"><Hero /><DiagonalBoundary boundary="heroToProof" /><ProofStrip /><DiagonalBoundary boundary="proofToMethod" /><HowIWork /><DiagonalBoundary boundary="methodToTimeline" /><Timeline /><DiagonalBoundary boundary="timelineToFit" /><WhoIWorkBestWith /><DiagonalBoundary boundary="fitToContact" /><ContactBand /></main>
    <OpportunityTeaser />
    <footer class="wrap site-footer">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <div class="site-footer-links">
        <a href="/technical-due-diligence">Technical Due Diligence</a>
        <span aria-hidden="true">|</span>
        <a href="/privacy">Privacy Policy</a>
        <span aria-hidden="true">|</span>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </footer>
  </body>
</html>
