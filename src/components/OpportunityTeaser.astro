---
const personas = [
  'https://api.dicebear.com/10.x/voxel-art/svg?glassesProbability=100&beardProbability=100&cheeksProbability=100&animationProbability=0&beardVariant=full,goatee,stubble&glassesVariant=round,shades,visor&backgroundColorFill=linear&backgroundColorFillStops=2&mouthVariant=flat:1,grin:1,laugh:1,smirk:0.7&outfitVariant=coat:1,dress:1,jacket:1,suit:1,tie:1&topVariant=beanie:0.8,cap:0.8,curly:1,halfShaved:1,mohawk:1,spiky:1&tags=animation&seed=Felix',
  'https://api.dicebear.com/10.x/voxel-art/svg?glassesProbability=100&beardProbability=100&cheeksProbability=100&animationProbability=0&beardVariant=full,goatee,stubble&glassesVariant=round,shades,visor&backgroundColorFill=linear&backgroundColorFillStops=2&mouthVariant=flat:1,grin:1,laugh:1,smirk:0.7&outfitVariant=coat:1,dress:1,jacket:1,suit:1,tie:1&topVariant=beanie:0.8,cap:0.8,curly:1,halfShaved:1,mohawk:1,spiky:1&tags=animation&skinColor=f5d0b0,eab890&shoesColor=343a40,1971c2,f08c00&shirtColor=12b886,228be6,4c6ef5,495057,ffffff&jacketColor=343a40,3b5b8c,6b4f3a,b55239,207f1f&seed=qaokud6w',
  'https://api.dicebear.com/10.x/voxel-art/svg?glassesProbability=100&beardProbability=100&cheeksProbability=100&animationProbability=0&beardVariant=full,goatee,stubble&glassesVariant=round&backgroundColorFill=linear&backgroundColorFillStops=2&mouthVariant=flat:1,grin:1,laugh:1,smirk:0.7&outfitVariant=coat:1,dress:1,jacket:1,suit:1,tie:1&topVariant=beanie:0.8,cap:0.8,curly:1,halfShaved:1,mohawk:1,spiky:1&tags=animation&skinColor=f5d0b0,eab890&shoesColor=343a40,1971c2,f08c00&shirtColor=12b886,228be6,4c6ef5,495057,ffffff&jacketColor=343a40,3b5b8c,6b4f3a,b55239,207f1f&seed=kx1iv0zh',
];
const teaserDescription = 'Do you want to get a worry, a complete project proposal, or a blocker in your AI initiatives off your chest? A locally processed voice agent is coming to this page soon!';
---
<div
  class="opportunity-teaser opportunity-teaser-trigger"
  data-opportunity-teaser
  data-opportunity-trigger
  data-state="idle"
  role="button"
  tabindex="0"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-label="Preview AI opportunity mapping teaser"
>
    <span class="opportunity-teaser-orb" data-opportunity-orb aria-hidden="true">
      <span class="opportunity-teaser-frame"></span>
      <span class="opportunity-teaser-track opportunity-teaser-track-a"></span>
      <span class="opportunity-teaser-track opportunity-teaser-track-b"></span>
      <span class="opportunity-teaser-track opportunity-teaser-track-c"></span>
      <span class="opportunity-teaser-grid"></span>
      <span class="opportunity-teaser-persona opportunity-teaser-persona-1" data-opportunity-persona>
        <img src={personas[0]} alt="" loading="lazy" decoding="async" />
      </span>
      <span class="opportunity-teaser-persona opportunity-teaser-persona-2" data-opportunity-persona>
        <img src={personas[1]} alt="" loading="lazy" decoding="async" />
      </span>
      <span class="opportunity-teaser-persona opportunity-teaser-persona-3" data-opportunity-persona>
        <img src={personas[2]} alt="" loading="lazy" decoding="async" />
      </span>
      <span class="opportunity-teaser-south-gap" data-opportunity-south-gap></span>
    </span>
    <div class="opportunity-teaser-description">{teaserDescription}</div>
    <span class="opportunity-teaser-pill">Available soon</span>
</div>

<script>
  import { initOpportunityTeaser } from '../scripts/opportunity-teaser';

  const bootOpportunityTeaser = () => initOpportunityTeaser(document);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootOpportunityTeaser, { once: true });
  } else {
    bootOpportunityTeaser();
  }
</script>
