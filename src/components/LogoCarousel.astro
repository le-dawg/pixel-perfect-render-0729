---
import { clientMarks } from '../data/clients';

const items = [...clientMarks, ...clientMarks];
---
<div class="logo-carousel" aria-label="Selected organisations">
  <div class="logo-track">
    {items.map((client, index) => <span class="logo-pill" aria-hidden={index >= clientMarks.length ? 'true' : 'false'}>{client}</span>)}
  </div>
</div>
