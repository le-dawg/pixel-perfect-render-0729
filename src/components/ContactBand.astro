---
import ContactLinks from './ContactLinks.astro';
---
<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-band">
    <p class="contact-label">Start the conversation</p>
    <h2 id="contact-title">Bring one stuck initiative.</h2>
    <p class="contact-subline">A rough problem statement is enough. Bring the initiative where AI access exists but value still is not showing up in throughput, trust, or operating clarity.</p>
    <ContactLinks />
  </div>
</section>
