---
import ContactLinks from './ContactLinks.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import Portrait from './Portrait.astro';

const lines = [
  "We have AI access now, but the tools aren&rsquo;t making us faster",
  "We&rsquo;re drowning in output, but verification is choking us now",
  "We track token spend perfectly, tool calls, data access, but the bottom line has moved in the wrong direction!",
  "We&rsquo;re a <s>hardware</s> business, AI can&rsquo;t help us here",
  "We&rsquo;re a <s>people</s> business, AI can&rsquo;t help us here",
  "We&rsquo;re an <s>infrastructure</s> business, AI can&rsquo;t help us here",
  "We&rsquo;re an <s>R&amp;D lab</s> here, AI like this can&rsquo;t help us",
];
---
<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-backdrop-shell">
    <HeroBackdrop />
  </div>
  <div class="hero wrap">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="hero-rotator" data-lines={JSON.stringify(lines)}>
          <span class="hero-rotator-line" set:html={lines[0]} />
        </span>
      </h1>
      <div class="hero-copy-flow">
        <p class="hero-subline">AI is an amplifier of your processes: better process leads to much better and faster AI ROI.</p>
        <div class="hero-support">
          <p>But you don&rsquo;t have the time to figure out where the <em>current</em> capabilities can achieve the highest benefit:</p>
          <ul>
            <li>across departments</li>
            <li>across jurisdictions</li>
          </ul>
          <p>And you lack the people to implement what&rsquo;s already on the roadmap.</p>
          <p class="hero-closing">If you are drowning in an ocean of opportunity, a hero is what you need.</p>
        </div>
        <ContactLinks />
      </div>
    </div>
    <aside class="hero-rail" aria-label="Credibility rail">
      <div class="hero-proof">
        <p class="hero-proof-label">Selected proof</p>
        <h2>Built in live robotics deployments, research-heavy evidence pipelines, and enterprise AI delivery.</h2>
        <ul class="hero-proof-list">
          <li>Amazon Robotics deployment work in operating environments</li>
          <li>DLR evidence pipelines for experimental systems</li>
          <li>Enterprise AI delivery for financial and industrial clients</li>
        </ul>
      </div>
      <Portrait />
    </aside>
  </div>
</section>

<script>
  const rotator = document.querySelector<HTMLElement>('.hero-rotator');
  if (rotator) {
    const lines: string[] = JSON.parse(rotator.dataset.lines ?? '[]');
    const line = rotator.querySelector<HTMLElement>('.hero-rotator-line');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (line && lines.length > 1 && !reduceMotion) {
      let i = 0;
      window.setInterval(() => {
        line.classList.add('is-leaving');
        window.setTimeout(() => {
          i = (i + 1) % lines.length;
          line.innerHTML = lines[i];
          line.classList.remove('is-leaving');
          line.classList.add('is-entering');
          window.setTimeout(() => line.classList.remove('is-entering'), 840);
        }, 760);
      }, 6000);
    }
  }
</script>
